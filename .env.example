# PostgreSQL connection string (Supabase / Neon / Local PostgreSQL)
# Example Supabase pooled connection string:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Or direct connection string:
# DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop_billing?schema=public"

# Auth.js secret key (generate with: openssl rand -base64 32)
AUTH_SECRET="change-this-to-a-secure-random-secret-in-production-auth32"

# Application base URL
APP_URL="http://localhost:3000"

# Resend API for email delivery (password resets, invoices, dunning reminders)
RESEND_API_KEY="re_sample_api_key_here"
EMAIL_FROM="Brightloop <onboarding@resend.dev>"

# Billing cron job protection secret
CRON_SECRET="brightloop-cron-secret-long-random-string"

# Default currency for formatting minor units (INR or USD)
DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"

# Demo mode: show 1-click Demo login buttons on /login
NEXT_PUBLIC_DEMO_MODE=true

# Application timezone for billing schedules & availability windows
APP_TIMEZONE="Asia/Kolkata"

